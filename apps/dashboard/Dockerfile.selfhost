# Use the full Node image so workerd has a working CA trust store for outbound HTTPS.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

# Two pnpm versions on purpose: the rankloop workspace root and the vendored
# dashboard each pin their own in `packageManager`, and corepack honours the
# nearest one. Preparing both keeps the build offline-deterministic instead of
# letting corepack fetch mid-build.
RUN corepack enable \
  && corepack prepare pnpm@10.22.0 --activate \
  && corepack prepare pnpm@10.30.1 --activate

# ---------------------------------------------------------------------------
# THE BUILD CONTEXT IS THE REPO ROOT, not apps/dashboard.
#
# The dashboard depends on `@rankloop/engine` as `link:../../packages/engine`
# — a path that leaves apps/dashboard. Built from apps/dashboard, `pnpm
# install` happily writes a DANGLING symlink (it does not verify link: targets)
# and the image builds green; the failure only lands at container start, when
# the boot-time vite build dies with "Rollup failed to resolve import
# '@rankloop/engine'" and the container crashloops. Hence: root context.
#
#   docker build -f apps/dashboard/Dockerfile.selfhost -t rankloop:local .
#
# Ignore rules come from the root `.dockerignore`.
# ---------------------------------------------------------------------------

# Workspace manifests first, so a source-only change does not re-resolve deps.
# --frozen-lockfile validates every importer in pnpm-lock.yaml, so each one's
# package.json has to be here even though only the engine gets installed.
# tsconfig.base.json comes along because packages/engine/tsconfig.json extends
# it, and tsup's dts pass reads it.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/cli/package.json ./packages/cli/
COPY packages/engine/package.json ./packages/engine/
COPY packages/seo-data/package.json ./packages/seo-data/
RUN pnpm install --frozen-lockfile --filter @rankloop/engine

# The engine ships `dist/` (see packages/engine/tsup.config.ts: the dashboard
# links it from a separate pnpm root, so it cannot consume the raw
# `.ts`-extension source exports). `dist/` is gitignored, so a fresh clone —
# which is what this build always is — must build it here.
COPY packages/engine ./packages/engine
RUN pnpm --filter @rankloop/engine build

WORKDIR /app/apps/dashboard

COPY apps/dashboard/package.json apps/dashboard/pnpm-lock.yaml apps/dashboard/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/dashboard/ ./

EXPOSE 3001

# Readiness probe against the unauthenticated setup/health endpoint. The long
# start period covers migrations plus the boot-time vite build (skipped when
# the previous start's build is still valid; see docker-entrypoint.sh).
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

# Startup (preflight, migrations, conditional build, serve) lives in
# docker-entrypoint.sh. The repo .npmrc raises the V8 heap ceiling
# (node-options) so the ~7400-module SSR build doesn't OOM under Node's ~2GB
# default.
CMD ["sh", "docker-entrypoint.sh"]
