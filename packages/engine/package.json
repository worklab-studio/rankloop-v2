{
  "name": "@rankloop/engine",
  "version": "2.0.0-dev",
  "description": "The rankloop method as a pure TypeScript library: laws, scoring, briefs, quota, pool-mix, wire artifacts. Zero LLM calls by design.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
