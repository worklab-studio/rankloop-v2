{
  "name": "rankloop",
  "version": "2.0.0-dev",
  "description": "The offline laws gate: scaffold a repo for agent writing, then run the rankloop publish laws over its content tree as a CI status check. Makes no network call, ever.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rankloop": "./dist/rankloop.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rankloop/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
